# 复制为 .env 后填入。不要把真实 Key 提交到 git。
DASHSCOPE_API_KEY=
# 识图视觉模型，拍板后再改。建议：qwen3-vl-plus
QWEN_VL_MODEL=qwen3-vl-plus
# 知识过长切分 / 向量嵌入：与 VL 同一 Key
QWEN_EMBED_MODEL=text-embedding-v4
# 本机 Milvus（嵌入作业写入 knowledge_chunk）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=knowledge_chunk
# 知识 PDF：Unstructured Transform（Key 勿提交）
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
